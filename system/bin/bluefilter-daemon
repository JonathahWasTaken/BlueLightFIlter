#!/system/bin/sh
# Conditional scheduler and notification worker.

export PATH="/system/bin:/system/xbin:$PATH"

MODDIR=${BLUEFILTER_MODDIR:-/data/adb/modules/bluelightfilter}
if [ "${BLUEFILTER_TESTING:-0}" = 1 ]; then
    CORE=${BLUEFILTER_CORE:?}
    CLI=${BLUEFILTER_CLI:?}
    CMD=${BLUEFILTER_CMD:?}
else
    CORE=/system/bin/bluefilter-core
    CLI=/system/bin/bluefilter
    CMD=/system/bin/cmd
fi

CONFIG_FILE=$MODDIR/config.conf
STATE_FILE=$MODDIR/enabled
PIDFILE=$MODDIR/daemon.pid
INTERVAL=${BLUEFILTER_INTERVAL:-60}
NOTIFICATION_TAG=bluelightfilter
last_notification=
posted_notification=0

[ -r "$CORE" ] || exit 3
# Production path is fixed; tests inject the same trusted library.
# shellcheck disable=SC1090
. "$CORE"

feature_enabled() {
    value=$(config_get "$CONFIG_FILE" "$1" enabled 2>/dev/null || true)
    [ "$value" = 1 ]
}

features_required() {
    feature_enabled schedule || feature_enabled notification
}

cancel_notification() {
    [ "$posted_notification" -eq 1 ] || return 0
    "$CMD" notification cancel "$NOTIFICATION_TAG" >/dev/null 2>&1
    posted_notification=0
    last_notification=
}

cleanup() {
    cancel_notification
    if [ -f "$PIDFILE" ] && [ "$(cat "$PIDFILE" 2>/dev/null)" = "$$" ]; then
        rm -f "$PIDFILE"
    fi
    exit 0
}
trap cleanup HUP INT TERM

if ! features_required; then
    rm -f "$PIDFILE"
    exit 0
fi

temporary_pid=$PIDFILE.tmp.$$
umask 077
printf '%s\n' "$$" > "$temporary_pid" || exit 3
mv "$temporary_pid" "$PIDFILE" || exit 3

resolve_intent() {
    if pm path io.github.a13e300.ksuwebui >/dev/null 2>&1; then
        printf '%s\n' 'intent:#Intent;component=io.github.a13e300.ksuwebui/.WebUIActivity;S.id=bluelightfilter;end'
    elif pm path com.dergoogler.mmrl >/dev/null 2>&1; then
        printf '%s\n' 'intent:#Intent;component=com.dergoogler.mmrl/.ui.activity.webui.WebUIActivity;S.MOD_ID=bluelightfilter;end'
    fi
}

post_notification() {
    if [ -f "$STATE_FILE" ]; then
        profile=$(state_get "$STATE_FILE" profile 2>/dev/null || printf unknown)
        profile_exists "$profile" || profile=unknown
        key=on:$profile
        title='BlueLightFIlter active'
        text="Profile: $profile"
    else
        key=off
        title='BlueLightFIlter inactive'
        text='Filter is off'
    fi
    [ "$key" = "$last_notification" ] && return 0
    intent=$(resolve_intent)
    if [ -n "$intent" ]; then
        "$CMD" notification post --ongoing -t "$title" -I "$intent" "$NOTIFICATION_TAG" "$text" >/dev/null 2>&1
    else
        "$CMD" notification post --ongoing -t "$title" "$NOTIFICATION_TAG" "$text" >/dev/null 2>&1
    fi
    posted_notification=1
    last_notification=$key
}

while features_required; do
    if feature_enabled schedule; then
        "$CLI" schedule evaluate >/dev/null 2>&1
    fi
    if feature_enabled notification; then
        post_notification
    else
        cancel_notification
    fi
    [ "${BLUEFILTER_ONCE:-0}" = 1 ] && break
    sleep "$INTERVAL"
done

cleanup
